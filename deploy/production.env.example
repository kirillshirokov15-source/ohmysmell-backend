# Copy values into the selected production service, never commit real secrets.
# Common: DATABASE_URL is SECRET; all other values below are non-secret.
APP_ENV=production
DATABASE_URL=
EXTERNAL_WRITES_ENABLED=false
DEBUG_ENDPOINTS_ENABLED=false
MONITORING_ENABLED=false
# Optional SECRET; unused while monitoring disabled.
SENTRY_DSN=

# BACKEND required SECRET; generate >=32 random characters.
INTERNAL_API_TOKEN=
# BACKEND required non-secret: exact final HTTPS origins, comma-separated.
CORS_ORIGINS=
PUBLIC_CHECKOUT_ENABLED=false

# Catalog/matching: SECRET token, read-only privileges until activation.
MOYSKLAD_TOKEN=
# Non-secret business configuration. IDs from the intended account only.
MOYSKLAD_WHOLESALE_PRICE_TYPE=Цена продажи
MOYSKLAD_RETAIL_PRICE_TYPE=
MOYSKLAD_WAREHOUSE_IDS=
MOYSKLAD_CATALOG_CACHE_TTL_SECONDS=60
# Required only when external writes are activated.
MOYSKLAD_ORGANIZATION_ID=

# MANAGER worker SECRET. CLIENT worker uses a DIFFERENT SECRET token.
TELEGRAM_BOT_TOKEN=
CLIENT_TELEGRAM_BOT_TOKEN=
BOT_PRODUCTION_ACTIVATED=false

# EMAIL worker: paths non-secret; file contents SECRET on persistent volume.
GMAIL_CREDENTIALS_FILE=/data/secrets/gmail-credentials.json
GMAIL_TOKEN_FILE=/data/secrets/gmail-token.json
GMAIL_USER_ID=me
GMAIL_INITIAL_QUERY=label:inbox is:unread
# Optional production canary selector; mandatory in staging.
GMAIL_ALLOWED_MESSAGE_IDS=
# Required in production if no canary IDs; owner-approved query with cutover boundary.
GMAIL_ORDER_QUERY=
# Optional SECRET alternative to mounted JSON files. Runtime reconstructs missing
# files; use writable /tmp/ohmysmell-gmail paths for ephemeral Railway containers.
GMAIL_CREDENTIALS_JSON_BASE64=
GMAIL_TOKEN_JSON_BASE64=
EMAIL_POLL_INTERVAL=60
EMAIL_PRODUCTION_ACTIVATED=false

# Delivery-only secrets: not required until submitting real orders.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YANDEX_DELIVERY_TOKEN=
