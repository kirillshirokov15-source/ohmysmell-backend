APP_NAME=OhMySmell CRM
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/ohmysmell
STAGING_DATABASE_URL=postgresql://staging_user:password@staging_host:5432/ohmysmell_staging

MOYSKLAD_TOKEN=
MOYSKLAD_WHOLESALE_PRICE_TYPE=Цена продажи
MOYSKLAD_RETAIL_PRICE_TYPE=
MOYSKLAD_ORGANIZATION_ID=
# Comma-separated IDs of the two approved active stores. Empty: all active stores.
MOYSKLAD_WAREHOUSE_IDS=
MOYSKLAD_CA_BUNDLE=
EXTERNAL_WRITES_ENABLED=false
MOYSKLAD_CATALOG_CACHE_TTL_SECONDS=60

TELEGRAM_BOT_TOKEN=
# Separate client bot only; never reuse the manager token.
CLIENT_TELEGRAM_BOT_TOKEN=
# Separate client worker. Enable only for approved synthetic staging acceptance.
CLIENT_TELEGRAM_ENABLED=false
CLIENT_TELEGRAM_BOT_USERNAME=
CLIENT_TELEGRAM_LINK_TTL_MINUTES=30
CLIENT_ORDER_DESK_ENABLED=false
# Telegram helpdesk outbox only; does not enable email or MoySklad writes.
ORDER_DESK_SEND_ENABLED=false
# Keep the public Tilda connection off until payload/bridge acceptance.
TILDA_ENABLED=false
TILDA_WEBHOOK_SECRET=
TILDA_ALLOW_QUERY_SECRET=false
TILDA_DEFAULT_CURRENCY=RUB
TILDA_FIELD_MAP_JSON={}
TILDA_ITEM_FIELD_MAP_JSON={}
# Operator-reviewed retail snapshot, integer kopecks. No wholesale fallback.
# Example: {"external-sku":{"product_id":"existing-product-id","retail_price_minor":19900}}
TILDA_PRODUCT_MAP_JSON={}
BOT_ROLE=manager
BOT_PRODUCTION_ACTIVATED=false

GMAIL_CREDENTIALS_FILE=C:/secure/ohmysmell/gmail-credentials.json
GMAIL_TOKEN_FILE=C:/secure/ohmysmell/gmail-token.json
GMAIL_USER_ID=me
GMAIL_INITIAL_QUERY=label:inbox is:unread
# Required for controlled staging intake; enforced on bootstrap, history and recovery.
GMAIL_ALLOWED_MESSAGE_IDS=
# Optional additional filter, applied to bootstrap/history/recovery; never enabled implicitly.
GMAIL_ORDER_QUERY=
GMAIL_QUERY_INTAKE_ENABLED=false
# Optional Railway secrets: base64 JSON reconstructed at the configured private paths.
# These values are secrets, never command-line arguments or committed file contents.
GMAIL_CREDENTIALS_JSON_BASE64=
GMAIL_TOKEN_JSON_BASE64=
EMAIL_POLL_INTERVAL=60

INTERNAL_API_TOKEN=
STAGING_INTERNAL_API_TOKEN=
DEBUG_ENDPOINTS_ENABLED=false
PUBLIC_CHECKOUT_ENABLED=false
# Replace with exact final HTTPS Tilda/custom-domain origins before activation.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production example: https://REPLACE-WITH-FINAL-SITE.example

CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YANDEX_DELIVERY_TOKEN=
# PORT is supplied by Railway; local staging runner listens on 127.0.0.1:8001.
PORT=8000
# Buying shared workspace (unset = API fails closed). Never commit actual values.
BUYING_SESSION_SECRET=
BUYING_ALLOWED_ORIGINS=https://ohmysmell-buying.christiankvyatkovsky.chatgpt.site
MANAGER_TELEGRAM_MODE=auto
SUPPLIER_EMAIL_SEND_ENABLED=false
SUPPLIER_REPLIES_ENABLED=false
# Shared group is enabled only with an explicit chat and actor allowlist.
MANAGER_TELEGRAM_CHAT_ID=
MANAGER_TELEGRAM_USER_IDS=

# Separate Gmail accounts. Legacy GMAIL_* is CUSTOMER-only.
CUSTOMER_GMAIL_CREDENTIALS_FILE=
CUSTOMER_GMAIL_TOKEN_FILE=
CUSTOMER_GMAIL_CREDENTIALS_JSON=
CUSTOMER_GMAIL_TOKEN_JSON=
CUSTOMER_GMAIL_USER_ID=me
CUSTOMER_GMAIL_EXPECTED_EMAIL=
SUPPLIER_GMAIL_CREDENTIALS_FILE=
SUPPLIER_GMAIL_TOKEN_FILE=
SUPPLIER_GMAIL_CREDENTIALS_JSON=
SUPPLIER_GMAIL_TOKEN_JSON=
SUPPLIER_GMAIL_USER_ID=me
SUPPLIER_GMAIL_EXPECTED_EMAIL=
